# Copy to .env.local for local development, and set the same names in Vercel → Settings → Environment Variables.
# docs/SETUP.md explains where each value comes from.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only: never prefix with NEXT_PUBLIC_

# Your app's public URL (used in email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tracker.example.com

# Shared secret the Supabase scheduler sends to /api/cron/reminders. Generate: openssl rand -hex 32
CRON_SECRET=

# Web push (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Resend (reminder emails). EMAIL_FROM must use your verified domain.
RESEND_API_KEY=re_...
EMAIL_FROM="Life Tracker <reminders@tracker.example.com>"

# Cloudflare Turnstile site key (the secret key goes in Supabase → Auth → Attack Protection, not here).
# Leave empty locally to skip the CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
